---
import { getCollection, render } from 'astro:content';
interface Props { kind?: 'client' | 'training'; featuredOnly?: boolean; variant?: 'dark' | 'light'; eyebrow?: string; title?: string; }
const { kind = 'client', featuredOnly = false, variant = 'dark', eyebrow = 'What clients say', title } = Astro.props;
const items = (await getCollection('testimonials', ({ data }) => data.kind === kind && (!featuredOnly || data.featured)))
  .sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(items.map(async (t) => ({ t, Content: (await render(t)).Content })));
const odd = rendered.length % 2 === 1;
---
<section class={variant === 'dark' ? 'testimonials' : 'clients-section'}>
  <div class={variant === 'dark' ? 'test-inner' : 'clients-inner'}>
    <div class="eyebrow" style={variant === 'dark' ? 'color: var(--teal)' : ''}>{eyebrow}</div>
    {title && <h2>{title}</h2>}
    <div class="test-grid">
      {rendered.map(({ t, Content }, i) => (
        <figure class:list={['test-card', { wide: odd && i === rendered.length - 1 }]}>
          <blockquote><Content /></blockquote>
          <cite class:list={{ 'has-photo': !!t.data.photo }}>{t.data.photo && <img class="avatar" src={t.data.photo} alt="" width="48" height="48" loading="lazy" />}<span><strong>{t.data.name}</strong>{t.data.role && <> &middot; {t.data.role}</>}, {t.data.organisation}</span></cite>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  figure { margin: 0; }
  blockquote :global(p) { font-size: 16px; line-height: 1.75; font-style: italic; }
  .testimonials blockquote :global(p) { color: #fff; }
  .clients-section blockquote :global(p) { color: var(--charcoal); }
  .clients-section { width: 100%; }
  .clients-section .clients-inner { display: block; }
  .clients-section .test-grid { width: 100%; }
</style>
