---
// GA4 with Google Consent Mode v2. Everything is denied by default; analytics
// cookies are only set after the visitor clicks "Accept". The choice is kept in
// localStorage and can be changed from the "Cookie settings" link in the footer.
import settings from '../data/settings.json';
const gaId = settings.gaId;
---
{gaId && (
  <>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      var saved = null;
      try { saved = localStorage.getItem('sfg-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: saved === 'granted' ? 'granted' : 'denied',
      });
      gtag('js', new Date());
      gtag('config', gaId);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    </script>

    <div class="consent" id="consent" role="dialog" aria-label="Cookie choice" hidden>
      <p>We use Google Analytics cookies to see how people use this site. <a href="/privacy/">Privacy</a></p>
      <div class="consent-actions">
        <button class="btn btn-ghost-dark" type="button" data-consent="denied">Reject</button>
        <button class="btn btn-primary" type="button" data-consent="granted">Accept</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var box = document.getElementById('consent');
        var saved = null;
        try { saved = localStorage.getItem('sfg-consent'); } catch (e) {}
        if (!saved) box.hidden = false;
        function choose(value) {
          try { localStorage.setItem('sfg-consent', value); } catch (e) {}
          window.gtag('consent', 'update', { analytics_storage: value });
          box.hidden = true;
        }
        box.querySelectorAll('[data-consent]').forEach(function (b) {
          b.addEventListener('click', function () { choose(b.getAttribute('data-consent')); });
        });
        document.querySelectorAll('[data-cookie-settings]').forEach(function (a) {
          a.addEventListener('click', function (e) { e.preventDefault(); box.hidden = false; });
        });
      })();
    </script>
  </>
)}
