---
import Base from '../../layouts/Base.astro';
import CtaStrip from '../../components/CtaStrip.astro';
import { getCollection } from 'astro:content';
import settings from '../../data/settings.json';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Insights" description="Practical digital fundraising insights for charities and non-profits.">
  <section class="hero hero--news">
    <div class="hero-inner">
      <div class="eyebrow" style="color: var(--teal)">Insights</div>
      <h1>Insights</h1>
      <p>Notes on digital fundraising from Andrew.</p>
    </div>
  </section>
  <section class="news-grid">
    {posts.length ? (
      <div class="news-inner">
        {posts.map((p) => (
          <a class="news-card" href={`/insights/${p.id}/`}>
            {p.data.image && <img class="news-image" src={p.data.image} alt="" loading="lazy" style="object-fit:cover;width:100%" />}
            <div class="news-body">
              <div class="news-tag">{p.data.tag}</div>
              <h2>{p.data.title}</h2>
              <p>{p.data.summary}</p>
              <div class="news-cta">Read &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty">
        <h2 class="section-h2">No posts yet.</h2>
        <p>Until then, Andrew shares digital fundraising tips on LinkedIn.</p>
        {settings.linkedin && <a class="btn btn-teal mt-32" href={settings.linkedin}>Follow on LinkedIn &rarr;</a>}
      </div>
    )}
  </section>
  <CtaStrip />
</Base>
